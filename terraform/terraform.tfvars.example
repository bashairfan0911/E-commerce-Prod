# AWS Configuration
aws_region = "us-east-1"
environment = "production"

# EC2 Instance Configuration
instance_type = "t3.medium"
instance_name = "ekomart-k8s-server"
key_name      = "ekomart-key"
root_volume_size = 30

# AMI Configuration
# Option 1: Use specific AMI ID (recommended for production)
# ami_id = "ami-0c55b159cbfafe1f0"

# Option 2: Use latest AMI with filters (default)
# Leave ami_id empty and configure these:
ami_owner = "099720109477"  # Canonical (Ubuntu)
ami_name_filter = "ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"

# Common AMI configurations:
# Ubuntu 22.04 LTS (Jammy):
#   ami_owner = "099720109477"
#   ami_name_filter = "ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"
#
# Ubuntu 20.04 LTS (Focal):
#   ami_owner = "099720109477"
#   ami_name_filter = "ubuntu/images/hvm-ssd/ubuntu-focal-20.04-amd64-server-*"
#
# Ubuntu 24.04 LTS (Noble):
#   ami_owner = "099720109477"
#   ami_name_filter = "ubuntu/images/hvm-ssd/ubuntu-noble-24.04-amd64-server-*"
#
# Amazon Linux 2:
#   ami_owner = "137112412989"
#   ami_name_filter = "amzn2-ami-hvm-*-x86_64-gp2"
#
# Amazon Linux 2023:
#   ami_owner = "137112412989"
#   ami_name_filter = "al2023-ami-*-x86_64"

# Security Configuration
allowed_ssh_cidr = "0.0.0.0/0"  # Change to your IP for better security
allowed_management_cidr = "0.0.0.0/0"  # Change to your IP for better security

# Additional Options
create_elastic_ip = true
enable_monitoring = true
